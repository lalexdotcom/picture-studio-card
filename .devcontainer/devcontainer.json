{
	"name": "Scaffold",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",
	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		"ghcr.io/devcontainers/features/docker-in-docker:3.0.0": {
			"moby": false
		},
		"ghcr.io/devcontainers-extra/features/apt-get-packages:1": {},
		"ghcr.io/devcontainers-extra/features/pnpm:2": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/uv:1": {
			"version": "latest"
		}
	},
	"forwardPorts": [
		8123
	],
	"mounts": [
		"source=ai-tools-config-${devcontainerId},target=/ai-tools,type=volume",
		"source=containerd-${devcontainerId},target=/var/lib/containerd,type=volume"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/ai-tools/.claude",
		"MEMPALACE_PALACE_PATH": "/ai-tools/.mempalace",
		"SERENA_HOME": "/ai-tools/.serena"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.vscode-typescript-next",
				"Anthropic.claude-code",
				"mhutchie.git-graph",
				"biomejs.biome",
				"github.vscode-github-actions",
				"bierner.github-markdown-preview",
				"bierner.markdown-preview-github-styles"
			],
			"settings": {
				"js/ts.tsserver.experimental.enableProjectDiagnostics": true,
				// Machine-scoped (the Claude Code extension declares both as `scope: machine`), so they
				// cannot live in .vscode/settings.json. They belong here rather than in post-create.sh:
				// VS Code writes these into ~/.vscode-server/data/Machine/settings.json BEFORE attaching,
				// whereas postCreateCommand runs after the window is already attached — too late for the
				// session that triggered the rebuild, which then starts without them.
				"claudeCode.allowDangerouslySkipPermissions": true,
				"claudeCode.initialPermissionMode": "bypassPermissions"
			}
		}
	},
	"postCreateCommand": ".devcontainer/post-create.sh"
}